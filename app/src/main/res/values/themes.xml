<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Normal Velvet app theme used after the splash screen. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Velvet splash screen: black background + the uploaded Velvet artwork. -->
    <style name="Theme.MyApplication.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/velvet_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

</resources>
