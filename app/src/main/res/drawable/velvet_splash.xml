<?xml version="1.0" encoding="utf-8"?>
<!--
    Keeps the complete Velvet splash artwork visible.
    The inset prevents Android's splash icon area from center-cropping
    the rounded-square artwork.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="32dp"
    android:insetTop="32dp"
    android:insetRight="32dp"
    android:insetBottom="32dp">

    <bitmap
        android:src="@drawable/velvet_splash_logo"
        android:gravity="fill" />

</inset>
